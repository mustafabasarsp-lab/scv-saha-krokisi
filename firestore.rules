rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Uygulamanın senkronize ettiği veri koleksiyonları. Listede olmayan bir
    // koleksiyon adına hiçbir işlem yapılamaz — yanlış yazılmış bir koleksiyon
    // adı sessizce yeni bir çöp koleksiyon açmasın.
    //
    // Liste iki kez yazılıyor (okuma ve yazma kuralı için) ve her ikisi de TEK
    // SATIRDA kalmalı: githooks/pre-commit bunu scv-saha-v1.html'deki
    // SYNC_KOLEKSIYONLARI ile satır bazlı karşılaştırıyor, satıra bölünürse
    // karşılaştırma sessizce boşa düşer.
    //
    // Not: liste bir yardımcı fonksiyona taşınıp "collection in fonksiyon()"
    // biçiminde kullanılınca Firebase Console ayrıştırıcısı hata veriyor
    // ("Unexpected '&&'"), bu yüzden bilerek satır içi bırakıldı.
    match /{collection}/{docId} {
      allow read, delete: if request.auth != null
        && collection in ['tarlalar','seralar','kirimlar','haritaPinleri','tesisPinleri','depoKutulari','sulamaKayitlari','iklimKayitlari','dayibasilar','yevmiyeKayitlari','odemeKayitlari','odemeAyarlari'];

      // create/update: uygulama her zaman belge id'sini kaydın kendi 'id'
      // alanıyla aynı tutar (bkz. scv-saha-v1.html syncOutgoingNow) — bu
      // eşleşmeyi zorunlu kılmak, bozuk/kötü niyetli bir yazmanın id'siz
      // veya başka bir kayda ait id ile belge oluşturmasını engeller.
      // keys().size() ise kaba bir akıl sağlığı sınırı: uygulamanın ürettiği
      // en geniş kayıt bile 100 alanın çok altında, bozuk bir döngünün belgeyi
      // 1 MiB'lik Firestore sınırına dayamasını erkenden durdurur.
      allow create, update: if request.auth != null
        && collection in ['tarlalar','seralar','kirimlar','haritaPinleri','tesisPinleri','depoKutulari','sulamaKayitlari','iklimKayitlari','dayibasilar','yevmiyeKayitlari','odemeKayitlari','odemeAyarlari']
        && request.resource.data.id == docId
        && request.resource.data.keys().size() <= 200;
    }

    // ---- Otomatik günlük yedekler ----
    // Asıl veriden AYRI durur ve uygulama tarafından dinlenmez; normal senkronun
    // silme tespiti buraya ulaşamaz, yani veriyi silen bir hata yedekleri silmez.
    //
    // Yedekler DEĞİŞTİRİLEMEZ (update yasak): bir günün yedeği bir kez yazılır.
    // Uygulama zaten yazmadan önce o günün künyesi var mı diye bakar; buradaki
    // yasak, bir hatanın alınmış yedeğin üzerine yazıp onu bozmasını engeller.
    // Silme serbesttir çünkü süresi dolan yedekleri uygulama kendisi temizler
    // (YEDEK_SAKLAMA_GUN, şu an 90 gün).
    match /yedekler/{docId} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.id == docId
        && request.resource.data.tarih is string
        && request.resource.data.tarih.size() == 10;
      allow update: if false;
    }
  }
}
